@startuml

class Etudiant {
    - id : int
    - nom : string
    - prenom : string
    - matricule : string
    + faireDemande()
}

class Residence {
    - id : int
    - nom : string
    - adresse : string
}

class Batiment {
    - id : int
    - nom : string
}

class Chambre {
    - numero : int
    - capacite : int
    - nombreOccupants : int
    + estDisponible()
}

class DemandeHebergement {
    - id : int
    - dateDemande : string
    - statut : string
    + accepter()
    + refuser()
}

class Attribution {
    - id : int
    - dateAttribution : string
}

Residence "1" -- "*" Batiment
Batiment "1" -- "*" Chambre
Etudiant "1" -- "*" DemandeHebergement
DemandeHebergement "1" -- "0..1" Attribution
Chambre "1" -- "*" Attribution

@enduml